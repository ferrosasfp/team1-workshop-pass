{
  "name": "team1-workshop-pass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo en vivo del workshop \"NFT mas alla del arte\" (Team1 LatAm): un NFT soulbound en Avalanche Fuji que funciona como credencial de acceso.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "npm run typecheck && npm run lint && npm run test && npm run build",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "contracts:sync-abi": "node scripts/sync-abi.mjs",
    "contracts:deploy:fuji": "cd contracts && forge script script/DeployPass.s.sol --rpc-url fuji --broadcast",
    "qa:full": "npm run contracts:test && npm run qa"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.56.3",
    "wagmi": "^3.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
